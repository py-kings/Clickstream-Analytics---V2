DEV_MODE=true

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=clickstream-events
KAFKA_GROUP_ID=clickstream_consumer

SPARK_MASTER=local[2]
SPARK_CHECKPOINT_PATH=./spark-checkpoints
SPARK_SHUFFLE_PARTITIONS=2

LOCAL_DELTA_BASE=./delta-lake

EVENT_RATE_PER_SEC=10
SIMULATION_DAYS=7

FORECAST_DAYS=14

# Airflow only: directory containing the src/ package (default /opt/airflow/dags)
# CLICKSTREAM_PROJECT_DIR=/absolute/path/to/clickstream-v2

# Optional: bucket for forecast output when AWS credentials are set
# CLICKSTREAM_BUCKET=your-bucket
